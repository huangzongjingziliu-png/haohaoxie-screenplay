<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 截至 2026-11-15：应用不接入分析、广告或崩溃上报 SDK，写作数据保存在本机；
	     AI 功能只在用户明确操作时把所选内容发给用户自己配置的模型服务。
	     TODO(上架前)：按 App Store Connect 隐私问卷的实际勾选逐项核对本文件。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 代码用 std::fs::metadata 读取文件大小/时间戳：容器内文件（C617.1），
				     以及用户通过选择框授权的文件（3B52.1）。
				     TODO(上架前)：逐个调用点核对后删去不需要的原因码。 -->
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
	</array>
	<!-- TODO(上架前)：核对 UserDefaults、磁盘空间、键盘输入等 Required Reason API 是否被间接调用。 -->
</dict>
</plist>
