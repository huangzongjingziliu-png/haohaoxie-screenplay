{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "好好写剧本",
  "version": "1.0.0",
  "identifier": "com.screenplay.studio.store",
  "build": {
    "beforeBuildCommand": "npm run build:store"
  },
  "bundle": {
    "targets": ["app"],
    "resources": {
      "resources/ocr_sidecar": "resources/ocr_sidecar",
      "resources/pdf_sidecar": "resources/pdf_sidecar",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../packaging/licenses/MPL-2.0.txt": "licenses/MPL-2.0.txt"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "bundleVersion": "1",
      "entitlements": "../packaging/app-store/app.entitlements.plist",
      "frameworks": ["../packaging/iap/Framework/StoreKitBridge.framework"],
      "files": {
        "Resources/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
      }
    }
  }
}
