{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "好好写剧本",
  "version": "0.1.58",
  "identifier": "com.screenplay.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "好好写剧本 · Screenplay Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ocr_sidecar",
      "resources/pdf_sidecar",
      "resources/agent/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "screenplay"
        ],
        "name": "好好写剧本剧本工程",
        "description": "好好写剧本剧本工程文件",
        "role": "Editor",
        "mimeType": "application/x-screenplay"
      }
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "../assets/installer/dmg-background.png",
        "windowSize": {
          "width": 820,
          "height": 680
        },
        "appPosition": {
          "x": 245,
          "y": 205
        },
        "applicationFolderPosition": {
          "x": 575,
          "y": 205
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMjYzM0ZDMEFBM0EzQTkKUldTcG82TUsvRE1tczd2Wll0TWt2encyQzJaMUlLbWdWbjhvQi9lekJESGlaeDFrVDArU2lPb0IK",
      "requireSignedVersion": true
    }
  }
}
